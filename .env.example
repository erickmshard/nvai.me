NEXT_PUBLIC_SITE_URL=

## Google Analytics (GA4)
# Prefer NEXT_PUBLIC_ variables so values are available in the browser
NEXT_PUBLIC_GOOGLE_TRACKING_ID=
# Fallback (server-side) key if you prefer; not required
GOOGLE_TRACKING_ID=

## Google AdSense
# Prefer NEXT_PUBLIC_ so script URL is available in the browser
NEXT_PUBLIC_GOOGLE_ADSENSE_URL=
# Fallback (server-side) key if you prefer; not required
GOOGLE_ADSENSE_URL=

## Public contact email used in UI
NEXT_PUBLIC_CONTACT_US_EMAIL=
# Fallback (server-side) key if you prefer; not required
CONTACT_US_EMAIL=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Default time zone for next-intl (IANA zone name)
# e.g. UTC, Asia/Shanghai, America/Los_Angeles
DEFAULT_TIME_ZONE=UTC

CRAWLER_API=
CRAWLER_API_KEY=

CRON_AUTH_KEY=

SUBMIT_AUTH_KEY=
